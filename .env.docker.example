# Copy this file to .env.docker.local and use the same values as production.
# This file is loaded into the container at runtime, not baked into the image.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-sb_secret-key
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM="City4Christ <hello@your-verified-domain.org>"

# Optional host port. The app still listens on port 3000 inside the container.
APP_PORT=3000
